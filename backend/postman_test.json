  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-set authorization header based on endpoint",
          "const requestPath = pm.request.url.path.join('/');",
          "let token = '';",
          "",
          "// Use admin token for admin endpoints",
          "if (requestPath.includes('admin')) {",
          "    token = pm.collectionVariables.get('admin_token');",
          "} else {",
          "    // Use member token for member and auth endpoints",
          "    token = pm.collectionVariables.get('member_token');",
          "}",
          "",
          "// If no specific token, try admin token as fallback",
          "if (!token || token.length === 0) {",
          "    token = pm.collectionVariables.get('admin_token');",
          "}",
          "",
          "// Add authorization header if token exists",
          "if (token && token.length > 0) {",
          "    pm.request.headers.add({",
          "        key: 'Authorization',",
          "        value: 'Bearer ' + token",
          "    });",
          "    console.log('Using token for ' + requestPath + ': ' + token.substring(0, 20) + '...');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test to log response info",
          "console.log('Response Status: ' + pm.response.code);",
          "console.log('Response Time: ' + pm.response.responseTime + 'ms');",
          "",
          "// Test for successful responses",
          "if (pm.response.code >= 200 && pm.response.code < 300) {",
          "    pm.test('Status code is successful', function () {",
          "        pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
          "    });",
          "}",
          "",
          "// Test for error responses",
          "if (pm.response.code >= 400) {",
          "    pm.test('Error response has message', function () {",
          "        const responseJson = pm.response.json();",
          "        pm.expect(responseJson).to.have.property('message');",
          "    });",
          "}"
        ]
      }
    }
  ]
}